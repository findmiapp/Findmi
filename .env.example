# Supabase
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe
# Create a Payment Link in the Stripe Dashboard for the $99/yr Founding Membership.
# Set its "After payment" redirect to {SITE_URL}/join/success
NEXT_PUBLIC_STRIPE_FOUNDING_LINK=https://buy.stripe.com/your-payment-link

# Tally
# Vendor onboarding form, opened from /join/success after a successful payment.
NEXT_PUBLIC_TALLY_ONBOARDING_URL=https://tally.so/r/your-onboarding-form-id
# Consumer inquiry form, embedded/linked from each business profile's Book / Inquire section.
# Findmi appends business_id, business_name, business_slug, and source as query params.
NEXT_PUBLIC_TALLY_INQUIRY_URL=https://tally.so/r/your-inquiry-form-id

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
