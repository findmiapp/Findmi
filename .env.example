# Supabase
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Project Settings -> API -> service_role key (server-only — never expose
# this to the client; only /admin's Server Actions read it). Required for
# /admin to read or write anything.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin (/admin)
# The one shared password for founder-only access — no accounts, no roles.
# Pick something long and random; it's also used to sign the session cookie.
ADMIN_PASSWORD=choose-a-strong-password
# Optional. Bumping this value (any change — "1" -> "2" is enough) and
# redeploying immediately invalidates every outstanding admin session,
# independent of ADMIN_PASSWORD — the real "revoke all sessions right now"
# switch (see src/lib/admin/auth.ts). Leave unset and nothing changes.
# Must not contain a "." character. Logout alone cannot do this — there is
# no runtime action that revokes a copied token faster than rotating this
# (or ADMIN_PASSWORD) and redeploying.
ADMIN_SESSION_VERSION=

# Stripe — legacy Founding Membership Payment Link. Superseded by the
# plan-aware server-side Stripe Checkout built into /join (see
# lib/commerce/membershipCheckout.ts) — no longer read by any page. Safe
# to leave unset or delete; kept here only in case of rollback.
NEXT_PUBLIC_STRIPE_FOUNDING_LINK=https://buy.stripe.com/your-payment-link

# Stripe — marketplace checkout AND membership billing (server-only, never
# exposed to the client). Secret key from the Stripe Dashboard (use a
# test-mode key while developing). Same key/webhook powers both the
# marketplace order checkout and the /join membership checkout — see
# src/app/api/webhooks/stripe/route.ts, which branches on which metadata
# key (findmi_order_id vs findmi_membership_id) a session carries.
STRIPE_SECRET_KEY=sk_test_your-secret-key
# Signing secret for the webhook endpoint at /api/webhooks/stripe — from the
# Stripe Dashboard's Webhooks page (or `stripe listen` in local dev).
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe — Recurring Billing V1 (Pro/Managed Pro subscriptions, server-only).
# Deliberately a SEPARATE, dedicated Stripe secret key/webhook from the pair
# above — recurring subscription billing never shares a key or webhook
# endpoint with the legacy one-time $99 checkout or marketplace orders. Leave
# all six of these unset to keep production on the legacy $99/year one-time
# checkout only: /upgrade/pro automatically falls back to that flow (see
# isRecurringCheckoutConfigured() in lib/commerce/subscriptionPricing.ts)
# until every one of these is configured.
STRIPE_SUBSCRIPTIONS_SECRET_KEY=
# Signing secret for the dedicated webhook endpoint at
# /api/webhooks/stripe/subscriptions — from that endpoint's own entry on the
# Stripe Dashboard's Webhooks page (or a separate `stripe listen` in local
# dev), NOT the same secret as STRIPE_WEBHOOK_SECRET above.
STRIPE_SUBSCRIPTIONS_WEBHOOK_SECRET=
# Stripe Price IDs for each recurring plan/interval — created in the Stripe
# Dashboard against the SAME account as STRIPE_SUBSCRIPTIONS_SECRET_KEY
# above. Never inferred, never inline `price_data` — Checkout always reads
# one of these four verbatim.
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_MANAGED_PRO_MONTHLY_PRICE_ID=
STRIPE_MANAGED_PRO_ANNUAL_PRICE_ID=

# Tally
# Vendor onboarding/intake form — shared by both membership paths (paid,
# from /join/success, and founder-invited/comped, from /admin/onboarding's
# generated invite link). Required hidden fields on the Tally form:
# membership_id, source, existing_business_id, plan (see lib/tally.ts).
NEXT_PUBLIC_TALLY_ONBOARDING_URL=https://tally.so/r/your-onboarding-form-id
# Consumer inquiry form, embedded/linked from each business profile's Book / Inquire section.
# Findmi appends business_id, business_name, business_slug, and source as query params.
NEXT_PUBLIC_TALLY_INQUIRY_URL=https://tally.so/r/your-inquiry-form-id
# $20 claim listing-activation payment form (one shared form for both
# business and event claims — see lib/tally.ts's getClaimPaymentFormUrl).
# Findmi appends claim_id and claim_type as query params/hidden fields.
# Required hidden fields to configure on the Tally form: claim_id,
# claim_type. The form must also have a $20 USD Payment question (Tally's
# built-in Stripe-backed payment block) configured.
NEXT_PUBLIC_TALLY_CLAIM_PAYMENT_URL=https://tally.so/r/your-claim-payment-form-id
# REQUIRED: Tally's webhook "Signing secret" (Settings -> Webhooks) for
# /api/webhooks/tally. Every branch of that webhook (vendor onboarding
# intake and $20 claim payments) fails closed: if this is unset, every
# webhook call is refused (503), and a missing or wrong signature is
# refused (401). Set it, and the same secret on each Tally form, before
# onboarding intake or claim payments can work in production.
TALLY_WEBHOOK_SECRET=

# Admin Action Email Notifications V1 — operational alerts for the
# founder/admin when something needs review (new Business/Event/Product/
# Marketplace submission, ownership claim, Market/Area request, inquiry,
# paid order — see src/lib/notifications/). Best-effort/secondary: a
# missing or invalid value here never fails the underlying user action,
# it only skips the email (see src/lib/notifications/send.ts).
#
# Resend API key (https://resend.com). Leave unset in local dev — sends
# are skipped with a server-side warning, not an error.
RESEND_API_KEY=
# Comma-separated recipient address(es) for admin operational
# notifications. Supports one or many, e.g.
# founder@findmi.app,ops@findmi.app. Leave unset to skip delivery (never
# hardcode a personal address in source).
ADMIN_NOTIFICATION_EMAILS=
# "From" address for admin operational notifications — must be a verified
# sending domain in Resend for production. Example:
# Findmi <notifications@findmi.app>
# Falls back to that same example value if unset (fine for local/dev
# testing against a Resend sandbox, not for real production sending).
ADMIN_NOTIFICATION_FROM=

# Anthropic — powers /admin/appearances/import (server-only, never exposed
# to the client). FindMi's first AI integration: extracts structured
# Appearance drafts from pasted schedule text and/or uploaded flyer/
# screenshot images. Without this set, the import page shows a clear
# "not configured" message instead of erroring.
ANTHROPIC_API_KEY=sk-ant-your-api-key
# Brand Onboarding (V1.1C) also uses this key for ONE optional, bounded
# enrichment call (existing category + short/About descriptions) during
# website analysis. Unset → that step is skipped; analysis still works.
# Optional server-only model override for that call (defaults to the same
# model as the Appearance importer).
ANTHROPIC_BRAND_MODEL=

# VCL A3b — verified Instagram discovery (PAID: Anthropic web search,
# $10 per 1,000 searches + model tokens). Off unless set to exactly "1"
# (and ANTHROPIC_API_KEY is set). When on, a signed-in Brand Build whose
# website exposes no Instagram runs at most ONE search (max_uses 1,
# instagram.com + the brand's domain), cached with that site's analysis.
# Web search must also be enabled for the organization in the Anthropic
# Console; set a workspace spend limit there as the global cost ceiling.
BRAND_INSTAGRAM_SEARCH_ENABLED=

# Brand Onboarding (V1.1C) — HMAC signing secret for the short-lived
# (30 min), HttpOnly Brand Identity draft cookie that carries Findmi's
# prepared candidate (incl. verified logo/cover candidates) from website
# analysis to Review Your Brand. Server-only; at least 32 random
# characters (e.g. `openssl rand -base64 48`). Dedicated — never reuse
# another secret. Unset/too short → no draft is created or accepted and
# onboarding falls back to the plain text prefill (no About/images).
# Changing it invalidates outstanding drafts (users simply re-run Build).
BRAND_DRAFT_SECRET=

# Weather (Homepage "Weather / Local Context" module)
# No env var needed. Provider is Open-Meteo (geocoding + current
# conditions), which is free and keyless — see src/lib/weather.ts. The
# city it looks up is founder-configured at /admin/site/homepage, not an
# environment variable.

# Media variants backfill CALIBRATION — mandatory execution gate for
# POST /admin/api/media-calibration (src/lib/admin/media-calibration.ts),
# the one-time tool that writes real derivative files + media_variants
# rows for 11 specific production originals to validate the legacy-variant
# registry before any full backfill. Leave unset (or any value other than
# the literal string "true") to keep POST refused even with a valid admin
# session and the correct confirm body — this is an intentional second,
# server-side-only switch a human must deliberately set and redeploy.
# GET (read-only preflight) is unaffected by this var.
MEDIA_CALIBRATION_ENABLED=

# Communication boundary (src/lib/communication-policy.ts) — server-side
# switch for unrestricted DIRECT messaging between organizations (Business ↔
# Business, Business ↔ Event, Business ↔ Location). Unset (or anything other
# than the literal "true") = OFF: those threads are read-only and new direct
# messages are refused; commercial requests go through Findmi. Set to "true"
# and redeploy/restart to turn direct messaging back on — no code, data or
# schema change. Opportunity threads and customer inquiries are unaffected
# either way. Server-only: never prefix with NEXT_PUBLIC_.
DIRECT_BUSINESS_MESSAGING_ENABLED=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics retention (optional). Whole days, at least 30. When set,
# Admin > Privacy Requests offers Apply Retention, which de-identifies
# analytics rows older than this (account link, referrer and session id
# removed; totals kept). Unset: no retention action is available.
ANALYTICS_RETENTION_DAYS=

# -----------------------------------------------------------------------------
# Discovery Engine + Map V1 (all optional)
# -----------------------------------------------------------------------------
# Basemap (MapLibre GL style URL). Default: OpenFreeMap's keyless public
# "positron" style. Any MapLibre-compatible style works; if it carries a key,
# use one the provider designed to be public and domain-restrict it there.
# The CSP (next.config.mjs) allows exactly this URL's origin.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Label glyph font for that style (must exist on its glyph server).
# NEXT_PUBLIC_MAP_LABEL_FONT=Noto Sans Regular
#
# Location geocoding (server-only; Admin → Locations → Map Placement).
# With GEOCODIO_API_KEY set, Geocodio is used (rooftop accuracy, IANA
# timezone, storable results). Without it, the keyless U.S. Census geocoder.
# GEOCODIO_API_KEY=
# GEOCODER=geocodio   # or "census" to force the Census geocoder
