# Supabase
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Project Settings -> API -> service_role key (server-only — never expose
# this to the client; only /admin's Server Actions read it). Required for
# /admin to read or write anything.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin (/admin)
# The one shared password for founder-only access — no accounts, no roles.
# Pick something long and random; it's also used to sign the session cookie.
ADMIN_PASSWORD=choose-a-strong-password

# Stripe — legacy Founding Membership Payment Link. Superseded by the
# plan-aware server-side Stripe Checkout built into /join (see
# lib/commerce/membershipCheckout.ts) — no longer read by any page. Safe
# to leave unset or delete; kept here only in case of rollback.
NEXT_PUBLIC_STRIPE_FOUNDING_LINK=https://buy.stripe.com/your-payment-link

# Stripe — marketplace checkout AND membership billing (server-only, never
# exposed to the client). Secret key from the Stripe Dashboard (use a
# test-mode key while developing). Same key/webhook powers both the
# marketplace order checkout and the /join membership checkout — see
# src/app/api/webhooks/stripe/route.ts, which branches on which metadata
# key (findmi_order_id vs findmi_membership_id) a session carries.
STRIPE_SECRET_KEY=sk_test_your-secret-key
# Signing secret for the webhook endpoint at /api/webhooks/stripe — from the
# Stripe Dashboard's Webhooks page (or `stripe listen` in local dev).
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Tally
# Vendor onboarding/intake form — shared by both membership paths (paid,
# from /join/success, and founder-invited/comped, from /admin/onboarding's
# generated invite link). Required hidden fields on the Tally form:
# membership_id, source, existing_business_id, plan (see lib/tally.ts).
NEXT_PUBLIC_TALLY_ONBOARDING_URL=https://tally.so/r/your-onboarding-form-id
# Consumer inquiry form, embedded/linked from each business profile's Book / Inquire section.
# Findmi appends business_id, business_name, business_slug, and source as query params.
NEXT_PUBLIC_TALLY_INQUIRY_URL=https://tally.so/r/your-inquiry-form-id
# Optional — Tally's webhook "Signing secret" (Settings -> Webhooks) for
# /api/webhooks/tally. If unset, intake submissions are still processed
# (no source verification) — set this in production once Tally's plan
# exposes it for the onboarding form.
TALLY_WEBHOOK_SECRET=

# Anthropic — powers /admin/appearances/import (server-only, never exposed
# to the client). FindMi's first AI integration: extracts structured
# Appearance drafts from pasted schedule text and/or uploaded flyer/
# screenshot images. Without this set, the import page shows a clear
# "not configured" message instead of erroring.
ANTHROPIC_API_KEY=sk-ant-your-api-key

# Weather (Homepage "Weather / Local Context" module)
# No env var needed. Provider is Open-Meteo (geocoding + current
# conditions), which is free and keyless — see src/lib/weather.ts. The
# city it looks up is founder-configured at /admin/site/homepage, not an
# environment variable.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
